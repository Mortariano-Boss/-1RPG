# ============================================================
# +1 RPG — Exemplo de configuração do FRONTEND
# Copie este arquivo para ".env" e preencha com seus valores.
# ============================================================

# URL pública do backend (sem barra no final)
REACT_APP_BACKEND_URL=http://localhost:8001

# Porta do socket do dev server (deixe como está em produção)
WDS_SOCKET_PORT=443

# Health check do ambiente
ENABLE_HEALTH_CHECK=true
